<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <RootNamespace>LineageVisualStudio</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <LineageInstrument>false</LineageInstrument>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <VsixVersion>$(LineageVersion)</VsixVersion>
    <LineageEmbeddedNupkg Condition="'$(LineageEmbeddedNupkg)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\embed\Lineage.$(LineageVersion).nupkg</LineageEmbeddedNupkg>
    <SourceVsixManifest>source.extension.vsixmanifest</SourceVsixManifest>
    <StartAction>Program</StartAction>
    <VsIde Condition="Exists('C:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE')">C:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE</VsIde>
    <StartProgram>$(VsIde)\devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.12.2069" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Design" />
    <Reference Include="System.Drawing" />
    <Reference Include="EnvDTE">
      <HintPath>$(VsIde)\PublicAssemblies\EnvDTE.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.15.0">
      <HintPath>$(VsIde)\PublicAssemblies\Microsoft.VisualStudio.Shell.15.0.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.Framework">
      <HintPath>$(VsIde)\PublicAssemblies\Microsoft.VisualStudio.Shell.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Interop">
      <HintPath>$(VsIde)\PublicAssemblies\Microsoft.VisualStudio.Interop.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.OLE.Interop">
      <HintPath>$(VsIde)\PublicAssemblies\Microsoft.VisualStudio.OLE.Interop.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Shell.Interop">
      <HintPath>$(VsIde)\PublicAssemblies\Microsoft.VisualStudio.Shell.Interop.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.TextManager.Interop">
      <HintPath>$(VsIde)\PublicAssemblies\Microsoft.VisualStudio.TextManager.Interop.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Threading">
      <HintPath>$(VsIde)\PublicAssemblies\Microsoft.VisualStudio.Threading.17.x\Microsoft.VisualStudio.Threading.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lineage.Ide\Lineage.Ide.csproj">
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup;BuiltProjectOutputGroupDependencies;GetCopyToOutputDirectoryItems;SatelliteDllsProjectOutputGroup</IncludeOutputGroupsInVSIX>
    </ProjectReference>
    <ProjectReference Include="..\Lineage.Runtime\Lineage.Runtime.csproj">
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup;BuiltProjectOutputGroupDependencies;GetCopyToOutputDirectoryItems</IncludeOutputGroupsInVSIX>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="LineagePackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <VSIXSourceItem Include="..\Lineage.Ide\bin\$(Configuration)\net472\Lineage.Ide.dll" />
    <VSIXSourceItem Include="..\Lineage.Runtime\bin\$(Configuration)\netstandard2.0\Lineage.Runtime.dll" />
    <VSIXSourceItem Include="$(LineageEmbeddedNupkg)" Condition="Exists('$(LineageEmbeddedNupkg)')">
      <VSIXSubPath>Packages</VSIXSubPath>
    </VSIXSourceItem>
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(VsSDKInstall)\Microsoft.VsSDK.targets" Condition="'$(VsSDKInstall)' != '' and Exists('$(VsSDKInstall)\Microsoft.VsSDK.targets')" />

  <Target Name="StampVsixManifestVersion" BeforeTargets="CreateVsixContainer">
    <XmlPoke XmlInputPath="$(IntermediateOutputPath)extension.vsixmanifest"
             Query="//*[local-name()='Identity']/@Version"
             Value="$(VsixVersion)"
             Condition="Exists('$(IntermediateOutputPath)extension.vsixmanifest')" />
  </Target>

  <Target Name="BuildVsix" AfterTargets="Build" DependsOnTargets="CreateVsixContainer" />
</Project>
