<UserControl x:Class="LineageIde.LineageFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LineageIde"
             x:Name="Root"
             Background="#1E1E1E">
  <UserControl.Resources>
    <Style x:Key="FlowCardStyle" TargetType="Border">
      <Setter Property="Background" Value="#2D2D30"/>
      <Setter Property="BorderBrush" Value="#3F3F46"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Cursor" Value="Arrow"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding CanNavigate}" Value="True">
          <Setter Property="Cursor" Value="Hand"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsFocus}" Value="True">
          <Setter Property="BorderBrush" Value="#8A7340"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="BorderBrush" Value="#007ACC"/>
          <Setter Property="BorderThickness" Value="2"/>
          <Setter Property="Background" Value="#31313A"/>
        </DataTrigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#3E3E42"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <ScrollViewer x:Name="Scroller"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Background="#1E1E1E"
                PreviewMouseWheel="Scroller_PreviewMouseWheel">
    <Grid x:Name="Surface"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Background="#1E1E1E">
      <Canvas x:Name="LinksLayer" IsHitTestVisible="False"/>
      <ItemsControl x:Name="Cards"
                    ItemsSource="{Binding Graph.Items, ElementName=Root}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}"/>
            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:LineageFlowItem}">
            <Border Width="{Binding Width}" Height="{Binding Height}"
                    Style="{StaticResource FlowCardStyle}"
                    ToolTip="{Binding HintText}"
                    PreviewMouseLeftButtonDown="Card_MouseLeftButtonUp">
              <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.28" Color="Black"/>
              </Border.Effect>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{Binding Accent}" CornerRadius="5,0,0,5"/>
                <Grid Grid.Column="1" Margin="8,5,8,6">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontSize="10" FontWeight="SemiBold"
                             Foreground="{Binding Accent}" Text="{Binding CategoryText}"/>
                  <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontSize="10"
                             HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                             Text="{Binding LocationText}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#8A8A8A"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CanNavigate}" Value="True">
                            <Setter Property="Foreground" Value="#569CD6"/>
                            <Setter Property="TextDecorations" Value="Underline"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding NameCaption}" FontSize="9"
                             Foreground="#6F6F6F" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                             Foreground="#DCDCDC" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <ItemsControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,3,0,2"
                                ItemsSource="{Binding Bindings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:LineageFlowBinding}">
                        <TextBlock Margin="0,1,0,1" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Text}">
                          <TextBlock.Foreground>
                            <SolidColorBrush Color="#B4D7EE"/>
                          </TextBlock.Foreground>
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding ValueCaption}" FontSize="9"
                             Foreground="#6F6F6F" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ValueText}" FontSize="11"
                             Foreground="#9CDCFE" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding HowCaption}" FontSize="9"
                             Foreground="#6F6F6F"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HowText}" FontSize="11"
                             Foreground="#DCDCAA" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </ScrollViewer>
</UserControl>
